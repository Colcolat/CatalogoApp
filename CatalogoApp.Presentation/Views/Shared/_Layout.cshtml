<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Catálogo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>

<header>
    <nav class="navbar navbar-expand-sm">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Catalogo" asp-action="Index">📼 Catálogo</a>

            <div class="d-flex align-items-center gap-2 ms-auto">
                @if (Context.Session.GetString("Username") != null)
                {
                    <span class="text-muted" style="font-size:.85rem">
                        👤 @Context.Session.GetString("Username")
                    </span>
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="Account" asp-action="Logout">Salir</a>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    <a class="btn btn-sm btn-primary"
                       asp-controller="Account" asp-action="Register">Registrarse</a>
                }
            </div>
        </div>
    </nav>
</header>

<div class="container" style="padding-top:2rem; padding-bottom:2rem">
    <main>@RenderBody()</main>
</div>

<footer class="footer">
    <div class="container">
        &copy; 2026 — Catálogo
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>