@model CatalogoApp.Domain.Models.Item

<h1>@Model.Titulo</h1>
<p><strong>Género:</strong> @Model.Genero</p>
<p><strong>Consola:</strong> @Model.Consola</p>
<p><strong>Año:</strong> @Model.Ano</p>
<p><strong>Descripción:</strong> @Model.Descripcion</p>

<hr />
<h3>Reviews</h3>

@foreach (var r in ViewBag.Reviews as List<CatalogoApp.Domain.Models.Review>)
{
    <div class="mb-2 p-2 border rounded">
        <strong>@r.Autor</strong> — @r.Estrellas ⭐<br />
        @r.Comentario
    </div>
}

@if (ViewBag.UsuarioLogueado != null)
{
    <h4 class="mt-3">Dejar una review</h4>
    <form asp-action="AgregarReview" method="post">
        <input type="hidden" name="ItemId" value="@Model.Id" />
        <div class="mb-2">
            <label>Estrellas (1–5)</label>
            <input name="Estrellas" type="number" min="1" max="5" class="form-control" required />
        </div>
        <div class="mb-2">
            <label>Comentario</label>
            <textarea name="Comentario" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-success">Publicar review</button>
    </form>
}
else
{
    <p><a asp-controller="Account" asp-action="Login">Inicia sesión</a> para dejar una review.</p>
}

<hr />
<a asp-action="Index">&larr; Volver al catálogo</a>