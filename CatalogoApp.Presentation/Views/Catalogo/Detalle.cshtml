@model CatalogoApp.Domain.Models.Item

@{
    var reviews = ViewBag.Reviews as List<CatalogoApp.Domain.Models.Review>;
    var usuario = ViewBag.UsuarioLogueado as string;

    string Estrellitas(int n) { return new string('★', n) + new string('☆', 5 - n); }
}

<a asp-action="Index" style="font-size:.85rem; color:var(--muted)">&larr; Volver</a>

<div class="detalle-header" style="margin-top:1.25rem">
    <h1 class="detalle-titulo">@Model.Titulo</h1>
    <div class="detalle-meta">
        <span> @Model.Consola</span>
        <span> @Model.Genero</span>
        <span> @Model.Ano</span>
    </div>
    <p style="margin-top:1rem; color:var(--muted); max-width:640px">@Model.Descripcion</p>
</div>

<!-- Reviews -->
<div class="reviews-section">
    <h3 style="margin-bottom:1.1rem">
        Reviews
        <span style="font-size:.8rem; color:var(--muted); font-weight:400; margin-left:.5rem">
            @reviews!.Count total
        </span>
    </h3>

    @if (!reviews!.Any())
    {
        <p class="text-muted" style="font-size:.875rem">Todavía no hay reviews. ¡Sé el primero!</p>
    }
    else
    {
        @foreach (var r in reviews)
        {
            <div class="review-card">
                <div class="review-header">
                    <span class="review-autor">@r.Autor</span>
                    <span class="stars">@Estrellitas(r.Estrellas)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(r.Comentario))
                {
                    <p class="review-text">@r.Comentario</p>
                }
            </div>
        }
    }

    @if (usuario != null)
    {
        <div class="review-form-box">
            <h4 style="margin-bottom:1rem; font-size:1rem">Dejar una review</h4>
            <form asp-action="AgregarReview" method="post">
                <input type="hidden" name="ItemId" value="@Model.Id"/>
                <div class="form-group">
                    <label>Estrellas</label>
                    <select name="Estrellas" class="form-control" style="max-width:160px">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <option value="@i">@(new string('★', i)) (@i)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Comentario (opcional)</label>
                    <textarea name="Comentario" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn btn-success">Publicar</button>
            </form>
        </div>
    }
    else
    {
        <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--surface);
                    border:1px solid var(--border); border-radius:var(--radius);
                    font-size:.875rem; color:var(--muted)">
            <a asp-controller="Account" asp-action="Login">Inicia sesión</a> para dejar una review.
        </div>
    }
</div>