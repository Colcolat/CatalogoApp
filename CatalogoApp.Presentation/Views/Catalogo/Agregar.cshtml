@model CatalogoApp.Domain.Models.Item

<a asp-action="Index" style="font-size:.85rem; color:var(--muted)">&larr; Cancelar</a>

<h1 class="page-title" style="margin-top:1.25rem; margin-bottom:1.5rem">Agregar item</h1>

<div class="form-box">
    <form asp-action="Agregar" method="post">
        <div class="form-group">
            <label>Título</label>
            <input asp-for="Titulo" class="form-control"/>
        </div>
        <div class="form-group">
            <label>Género</label>
            <input asp-for="Genero" class="form-control"/>
        </div>
        <div class="form-group">
            <label>Consola / Plataforma</label>
            <input asp-for="Consola" class="form-control"/>
        </div>
        <div class="form-group">
            <label>Año</label>
            <input asp-for="Ano" type="number" class="form-control" style="max-width:140px"/>
        </div>
        <div class="form-group">
            <label>Descripción</label>
            <textarea asp-for="Descripcion" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:.5rem">Guardar</button>
    </form>
</div>